# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a git.

# Meta for Developers → tu app → WhatsApp → Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Una palabra secreta que tú inventas y pegas también en la configuración del webhook en Meta
WHATSAPP_VERIFY_TOKEN=

# Meta for Developers → tu app → Configuración → Básica → Clave secreta de la app
WHATSAPP_APP_SECRET=

# Número del dueño del negocio para avisarle de cada cita (formato internacional, sin +). Opcional.
TELEFONO_DUENO=

# Versión de la Graph API. Revisa la vigente en la documentación de Meta.
GRAPH_API_VERSION=v21.0

ARCHIVO_CITAS=datos/citas.json
